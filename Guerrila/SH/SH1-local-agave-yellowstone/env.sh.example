#!/usr/bin/env bash
# Copy this file to env.sh and adjust values for the local Linux/WSL lab.

set -a

SH1_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SH1_ROOT="${SH1_DIR}/lab"
SH1_CLUSTER="${SH1_CLUSTER:-devnet}"   # devnet | testnet | mainnet-beta

SH1_RPC_BIND_ADDRESS="${SH1_RPC_BIND_ADDRESS:-127.0.0.1}"
SH1_RPC_PORT="${SH1_RPC_PORT:-8899}"
SH1_DYNAMIC_PORT_RANGE="${SH1_DYNAMIC_PORT_RANGE:-8000-8025}"

SH1_IDENTITY_PATH="${SH1_IDENTITY_PATH:-${SH1_ROOT}/validator-keypair.json}"
SH1_LEDGER_DIR="${SH1_LEDGER_DIR:-${SH1_ROOT}/ledger}"
SH1_SNAPSHOTS_DIR="${SH1_SNAPSHOTS_DIR:-${SH1_LEDGER_DIR}/snapshots}"
SH1_ACCOUNTS_DIR="${SH1_ACCOUNTS_DIR:-${SH1_ROOT}/accounts}"
SH1_LOG_DIR="${SH1_LOG_DIR:-${SH1_ROOT}/logs}"
SH1_TOOLING_DIR="${SH1_TOOLING_DIR:-${SH1_ROOT}/tooling}"
SH1_MAXIMUM_FULL_SNAPSHOTS_TO_RETAIN="${SH1_MAXIMUM_FULL_SNAPSHOTS_TO_RETAIN:-2}"
SH1_MAXIMUM_INCREMENTAL_SNAPSHOTS_TO_RETAIN="${SH1_MAXIMUM_INCREMENTAL_SNAPSHOTS_TO_RETAIN:-4}"

SH1_AGAVE_REPO_DIR="${SH1_AGAVE_REPO_DIR:-${SH1_ROOT}/agave}"
SH1_AGAVE_GIT_REF="${SH1_AGAVE_GIT_REF:-master}"

SH1_YELLOWSTONE_REPO_DIR="${SH1_YELLOWSTONE_REPO_DIR:-${SH1_ROOT}/yellowstone-grpc}"
SH1_YELLOWSTONE_GIT_REF="${SH1_YELLOWSTONE_GIT_REF:-master}"
SH1_YELLOWSTONE_CONFIG_PATH="${SH1_YELLOWSTONE_CONFIG_PATH:-${SH1_ROOT}/yellowstone-config.json}"
SH1_YELLOWSTONE_GRPC_ADDRESS="${SH1_YELLOWSTONE_GRPC_ADDRESS:-127.0.0.1:10000}"
SH1_YELLOWSTONE_PROMETHEUS_ADDRESS="${SH1_YELLOWSTONE_PROMETHEUS_ADDRESS:-127.0.0.1:8999}"
SH1_YELLOWSTONE_X_TOKEN="${SH1_YELLOWSTONE_X_TOKEN:-}"

SH1_SOLANA_METRICS_CONFIG="${SH1_SOLANA_METRICS_CONFIG:-}"
SH1_LIBCLANG_PATH="${SH1_LIBCLANG_PATH:-}"

set +a
