+    shadow_route.ctx.jito_compatible_now = true;
+    shadow_route.ctx.timing_margin_ok = true;
+    shadow_route.outcome = RouteOutcome {
+        decision: RouteDecision::JitoBundle,
+        reason: RouteReason::JitoDirect,
