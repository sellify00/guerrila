# /etc/systemd/system/sh4-agave-yellowstone-smoke.service
[Unit]
Description=SH4 Agave non-voting devnet validator with Yellowstone smoke
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/SH/SH1-local-agave-yellowstone
Environment=HOME=/home/ubuntu
ExecStart=/bin/bash -lc 'source /home/ubuntu/.cargo/env && cd /home/ubuntu/SH/SH1-local-agave-yellowstone && bash ./60_start_agave_with_yellowstone.sh'
Restart=on-failure
RestartSec=10
LimitNOFILE=1000000
LimitMEMLOCK=2000000000

[Install]
WantedBy=multi-user.target
