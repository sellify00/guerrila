#!/usr/bin/env bash
#
# Copy this file to env.sh and adjust values per host if needed.

set -a

SH2_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SH2_AUDIT_DIR="${SH2_AUDIT_DIR:-${HOME}/shadow-host-audit}"
SH2_HOST_TAG="${SH2_HOST_TAG:-shadow-solana-tokyo-sh2}"
SH2_IFACE="${SH2_IFACE:-}"

set +a
